# ============================================================
# Ghostty — Decay
# ============================================================
# ------------------------------------------------------------
# Font
# ------------------------------------------------------------
font-family = JetBrainsMono Nerd Font
font-size = 13
# Slightly better readability for terminal work
font-thicken = true
# ------------------------------------------------------------
# Window
# ------------------------------------------------------------
# Colors (bg/fg, ANSI palette, cursor, selection) come from themes/<name>,
# generated from the decaycs palettes alongside the Zed theme.
# Variants: Decay, Dark Decay, Decayce, Cosmic Decay, Light Decay
theme = Decay
# Transparency
background-opacity = 0.96
# macOS background blur
background-blur-radius = 20
# Don't let the window become completely opaque when focused
# Keep the same opacity whether focused or unfocused
unfocused-split-opacity = 1.0
# Padding
window-padding-x = 7
window-padding-y = 2
window-padding-balance = false
# macOS window appearance
window-decoration = true
# ------------------------------------------------------------
# Cursor
# ------------------------------------------------------------
cursor-style = block
cursor-style-blink = true
# Comet-like cursor trail (kitty-style), from https://github.com/sahaj-b/ghostty-cursor-shaders
custom-shader = shaders/cursor_tail.glsl
custom-shader-animation = always
# ------------------------------------------------------------
# Shell
# ------------------------------------------------------------

shell-integration = detect

# ------------------------------------------------------------
# Clipboard
# ------------------------------------------------------------

copy-on-select = false

# ------------------------------------------------------------
# Scrollback
# ------------------------------------------------------------

scrollback-limit = 10000

# ------------------------------------------------------------
# Mouse
# ------------------------------------------------------------

mouse-hide-while-typing = true

# ------------------------------------------------------------
# Bell
# ------------------------------------------------------------

bell-features = no-attention

# ------------------------------------------------------------
# macOS
# ------------------------------------------------------------

# New windows open in the current working directory
macos-option-as-alt = true
macos-titlebar-style = tabs

# unbind raycast toggle maximise
keybind = ctrl+opt+cmd+m=unbind
keybind = ctrl+opt+cmd+shift+h=unbind
keybind = ctrl+opt+cmd+shift+l=unbind

# send nvim's <leader>ff / <leader>bd instead of relying on <D-p>/<D-w> reaching nvim
keybind = cmd+p=text:\x1b ff
keybind = cmd+w=text:\x1b bd
